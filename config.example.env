# v6プラス固定IP (JPIX) 契約情報
#   cp config.example.env config.env && chmod 600 config.env
#   契約書の値に置き換えてください。以下はすべて例示値です。
WAN_IF="eth4"                                   # 固定IPを載せる WAN の物理IF
USERNAME="kotei0000000000"                      # 契約書のユーザID
PASSWORD="xxxxxxxx"                             # 契約書のパスワード
IPV4_CIDR="203.0.113.10/32"                     # 割り当てられた固定IPv4
IPV6_IID="::00cb:0071:0a00:0000"                # 契約書のIID。先頭の :: が必須
IPV6_REMOTE="2404:9200:225:100::65"             # 固定IP用BR (JPIX共通)
